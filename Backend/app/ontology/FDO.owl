    <rdfs:domain rdf:resource="http://example.org/fdo#RetentionPolicy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Retention duration associated with personal data.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#source">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>source</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#PrivacyPolicy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Source document or source location.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#Function">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Function</rdfs:label>
    <rdfs:comment>FDO semantic class representing Function.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#supportedByClause">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>supportedByClause</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#DeclaredData"/>
    <rdfs:range rdf:resource="http://example.org/fdo#PolicyClause"/>
    <rdfs:comment>Connects a declared data fact to policy evidence supporting it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#id">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
