<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://example.org/fdo#ProcessingActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ProcessingActivity</rdfs:label>
    <rdfs:comment>FDO semantic class representing ProcessingActivity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#hasUserRight">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasUserRight</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#PrivacyPolicy"/>
    <rdfs:range rdf:resource="http://example.org/fdo#UserRight"/>
    <rdfs:comment>Connects a privacy policy to user rights it provides.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>name</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#Application"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Human-readable name of an ontology entity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#Ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>Functional Data Ontology</rdfs:label>
    <rdfs:comment>Ontology for semantic analysis of application functionality, personal data processing, privacy policy evidence, and Functional Data Overreach.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#concernsData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>concernsData</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#Overreach"/>
    <rdfs:range rdf:resource="http://example.org/fdo#PersonalData"/>
    <rdfs:comment>Connects an overreach finding to the data involved.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#SensitiveData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>SensitiveData</rdfs:label>
    <rdfs:comment>FDO semantic class representing SensitiveData.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#RetentionPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>RetentionPolicy</rdfs:label>
    <rdfs:comment>FDO semantic class representing RetentionPolicy.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#hasUser">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasUser</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#Application"/>
    <rdfs:range rdf:resource="http://example.org/fdo#User"/>
    <rdfs:comment>Connects an application to its user context.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#FDOEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>FDOEntity</rdfs:label>
    <rdfs:comment>FDO semantic class representing FDOEntity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#sensitive">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>sensitive</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#PersonalData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:comment>Indicates whether a data type is sensitive.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#Application">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Application</rdfs:label>
    <rdfs:comment>FDO semantic class representing Application.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#declaredData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>declaredData</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#Application"/>
    <rdfs:range rdf:resource="http://example.org/fdo#DeclaredData"/>
    <rdfs:comment>Connects an application to data declared in its privacy policy.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#ExpectedData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ExpectedData</rdfs:label>
    <rdfs:comment>FDO semantic class representing ExpectedData.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#level">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>level</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#Risk"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Risk level associated with an FDO finding.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#Consent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Consent</rdfs:label>
    <rdfs:comment>FDO semantic class representing Consent.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#score">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>score</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#Risk"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>Numerical risk score.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#hasConsent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasConsent</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#Application"/>
    <rdfs:range rdf:resource="http://example.org/fdo#Consent"/>
    <rdfs:comment>Connects an application to a consent record.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#expectedForFunction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>expectedForFunction</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#ExpectedData"/>
    <rdfs:range rdf:resource="http://example.org/fdo#Function"/>
    <rdfs:comment>Connects expected data to the function for which it is expected.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#retention">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>retention</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#DeclaredData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Retention information associated with declared data.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#performsFunction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>performsFunction</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#Application"/>
    <rdfs:range rdf:resource="http://example.org/fdo#Function"/>
    <rdfs:comment>Connects an application to a function it performs.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#sharing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>sharing</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#DeclaredData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Sharing information associated with declared data.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#requiresData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>requiresData</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#Function"/>
    <rdfs:range rdf:resource="http://example.org/fdo#PersonalData"/>
    <rdfs:comment>Connects a function to data reasonably required for that function.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#hasRetentionPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasRetentionPolicy</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#PersonalData"/>
    <rdfs:range rdf:resource="http://example.org/fdo#RetentionPolicy"/>
    <rdfs:comment>Connects personal data to its retention policy.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#supportedByPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>supportedByPolicy</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#PolicyClause"/>
    <rdfs:range rdf:resource="http://example.org/fdo#PrivacyPolicy"/>
    <rdfs:comment>Connects a policy clause to its source privacy policy.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#reason">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>reason</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#Overreach"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Reason explaining an FDO finding.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#section">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>section</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#PolicyClause"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Policy section containing the clause.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#PrivacyPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>PrivacyPolicy</rdfs:label>
    <rdfs:comment>FDO semantic class representing PrivacyPolicy.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#hasRisk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasRisk</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#Overreach"/>
    <rdfs:range rdf:resource="http://example.org/fdo#Risk"/>
    <rdfs:comment>Connects an overreach finding to an associated privacy risk.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#text">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>text</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#PolicyClause"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Text of a policy clause or justification.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#Recipient">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Recipient</rdfs:label>
    <rdfs:comment>FDO semantic class representing Recipient.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#dataType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>dataType</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#ExpectedData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Type of personal data.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#status">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>status</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#Consent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Status of consent or an FDO finding.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#Justification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Justification</rdfs:label>
    <rdfs:comment>FDO semantic class representing Justification.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#concernsFunction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>concernsFunction</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#Overreach"/>
    <rdfs:range rdf:resource="http://example.org/fdo#Function"/>
    <rdfs:comment>Connects an overreach finding to the affected function.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#recipientType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>recipientType</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#Recipient"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Type of recipient receiving personal data.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#version">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>version</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#PrivacyPolicy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Version of the privacy policy.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#category">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>category</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#Application"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Category of an application.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#Purpose">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Purpose</rdfs:label>
    <rdfs:comment>FDO semantic class representing Purpose.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>description</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#Application"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Human-readable description of an ontology entity.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#confidence">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>confidence</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#Overreach"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <rdfs:comment>Confidence associated with an FDO finding.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#necessity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>necessity</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#ExpectedData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Necessity level of expected data.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#purpose">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>purpose</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#ExpectedData"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Purpose associated with expected data.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#justificationType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>justificationType</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#Justification"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Type of justification supporting an FDO finding.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#usedForPurpose">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>usedForPurpose</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#PersonalData"/>
    <rdfs:range rdf:resource="http://example.org/fdo#Purpose"/>
    <rdfs:comment>Connects personal data to its stated processing purpose.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#Risk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Risk</rdfs:label>
    <rdfs:comment>FDO semantic class representing Risk.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#collectsData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>collectsData</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#Application"/>
    <rdfs:range rdf:resource="http://example.org/fdo#PersonalData"/>
    <rdfs:comment>Connects an application to personal data it collects.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#declaredByApplication">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>declaredByApplication</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#DeclaredData"/>
    <rdfs:range rdf:resource="http://example.org/fdo#Application"/>
    <rdfs:comment>Connects declared data to the application declaring it.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#User">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>User</rdfs:label>
    <rdfs:comment>FDO semantic class representing User.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#expectedData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>expectedData</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#Function"/>
    <rdfs:range rdf:resource="http://example.org/fdo#ExpectedData"/>
    <rdfs:comment>Connects a function to expected data requirements.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#sharedWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>sharedWith</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/fdo#PersonalData"/>
    <rdfs:range rdf:resource="http://example.org/fdo#Recipient"/>
