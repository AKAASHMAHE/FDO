  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#PersonalData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>PersonalData</rdfs:label>
    <rdfs:comment>FDO semantic class representing PersonalData.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#duration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
