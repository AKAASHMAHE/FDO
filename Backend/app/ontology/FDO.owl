  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/fdo#DeclaredData">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>DeclaredData</rdfs:label>
    <rdfs:comment>FDO semantic class representing DeclaredData.</rdfs:comment>
  </rdf:Description>
