<http://example.org/fdo#resource/application/NAV-01> a fdo:Application ;
    fdo:category "Navigation" ;
    fdo:declaredData <http://example.org/fdo#resource/declared-data/AI-bde56b16> ;
    fdo:id "NAV-01" ;
    fdo:name "Google Maps" ;
    fdo:performsFunction <http://example.org/fdo#resource/function/NAV-01:FUNC.NAV.SEARCH>,
        <http://example.org/fdo#resource/function/NAV-01:FUNC.NAV.TRAFFIC>,
        <http://example.org/fdo#resource/function/NAV-01:FUNC.NAV.TURNBYTURN> .

<http://example.org/fdo#resource/declared-data/AI-bde56b16> a fdo:DeclaredData ;
    fdo:confidence "0.95"^^xsd:float ;
    fdo:dataType "DATA.LOCATION.PRECISE" ;
    fdo:dataTypeClass fdo:DataType_DATA_LOCATION_PRECISE ;
    fdo:declaredByApplication <http://example.org/fdo#resource/application/NAV-01> ;
    fdo:entity "third_party_advertiser" ;
    fdo:extractionStatus "EXTRACTED" ;
    fdo:id "AI-bde56b16" ;
    fdo:name "DATA.LOCATION.PRECISE" ;
    fdo:purpose "advertising" ;
    fdo:retention "30 days" ;
    fdo:sharing "shared" ;
    fdo:text "The application may collect precise location information for advertising purposes." .

<http://example.org/fdo#resource/expected-data/EXP-015> a fdo:ExpectedData ;
    fdo:dataType "DATA.LOCATION.PRECISE" ;
    fdo:dataTypeClass fdo:DataType_DATA_LOCATION_PRECISE ;
    fdo:expectedForFunction <http://example.org/fdo#resource/function/NAV-01:FUNC.NAV.TURNBYTURN> ;
    fdo:id "EXP-015" ;
    fdo:name "DATA.LOCATION.PRECISE" ;
    fdo:necessity "L1_REQUIRED" ;
    fdo:purpose "Route/navigation" .

<http://example.org/fdo#resource/expected-data/EXP-016> a fdo:ExpectedData ;
    fdo:dataType "DATA.LOCATION.PRECISE" ;
    fdo:dataTypeClass fdo:DataType_DATA_LOCATION_PRECISE ;
    fdo:expectedForFunction <http://example.org/fdo#resource/function/NAV-01:FUNC.NAV.TRAFFIC> ;
    fdo:id "EXP-016" ;
    fdo:name "DATA.LOCATION.PRECISE" ;
    fdo:necessity "L1_REQUIRED" ;
    fdo:purpose "Real-time traffic/navigation" .

<http://example.org/fdo#resource/expected-data/EXP-017> a fdo:ExpectedData ;
    fdo:dataType "DATA.LOCATION.APPROXIMATE" ;
    fdo:dataTypeClass fdo:DataType_DATA_LOCATION_APPROXIMATE ;
    fdo:expectedForFunction <http://example.org/fdo#resource/function/NAV-01:FUNC.NAV.SEARCH> ;
    fdo:id "EXP-017" ;
    fdo:name "DATA.LOCATION.APPROXIMATE" ;
    fdo:necessity "L2_SUPPORTIVE" ;
    fdo:purpose "Search/localization" .

fdo:DataType a owl:Class .

fdo:DataType_DATA_FINANCIAL a owl:Class ;
